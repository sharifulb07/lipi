# Required in production so canonical, Open Graph, robots, and sitemap URLs use your domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional persistent writable storage directory for uploads and converted files.
# When omitted, production uses the operating system temporary directory.
LIPI_STORAGE_DIR=/var/lib/lipi

# Recommended open-source Word compatibility backend for Vercel.
# Point this at a public HTTPS Collabora Online endpoint. Either the server root
# (the app adds /cool/convert-to/docx) or the complete conversion URL is valid.
WORD_COMPATIBILITY_API_URL=https://office-converter.example.com
# Optional bearer token enforced by your reverse proxy in front of Collabora.
WORD_COMPATIBILITY_API_TOKEN=

# Optional proprietary fallback when no open-source endpoint is configured.
CLOUDCONVERT_API_KEY=